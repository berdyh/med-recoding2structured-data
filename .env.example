# GP Consultation Extractor - Environment Variables

# ============================================
# LLM Provider Selection
# ============================================
# Set to 'true' to use AWS Bedrock, otherwise Gemini is used
AWS_BEDROCK_ENABLED=false

# ============================================
# Gemini Configuration (Default Provider)
# ============================================
LANGEXTRACT_API_KEY=your-gemini-api-key-here

# ============================================
# AWS Bedrock Configuration
# ============================================
# AWS Credentials for Bedrock access
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=us-east-1

# Bedrock Model ID (optional, defaults to Claude Sonnet 4.5)
# MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# ============================================
# Extraction Configuration
# ============================================
# Minimum confidence score for extracted entities (0.0 to 1.0)
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# ============================================
# Output Configuration
# ============================================
# Output directory for CSV files
OUTPUT_DIR=/output

# ============================================
# Logging Configuration
# ============================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
